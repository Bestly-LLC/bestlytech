<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>tech.bestly.insurance-filer</string>
<key>ProgramArguments</key><array><string>__HOME__/bestly-agents/insurance-filer/venv/bin/python</string><string>-u</string><string>__HOME__/bestly-agents/insurance-filer/filer.py</string></array>
<key>WorkingDirectory</key><string>__HOME__/bestly-agents/insurance-filer</string>
<key>EnvironmentVariables</key><dict>
<key>PATH</key><string>__HOME__/.local/node/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
<key>PLAYWRIGHT_BROWSERS_PATH</key><string>__HOME__/bestly-agents/insurance-filer/browsers</string>
</dict>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>300</integer>
<key>ProcessType</key><string>Background</string>
<key>StandardOutPath</key><string>__HOME__/logs/insurance-filer.out.log</string>
<key>StandardErrorPath</key><string>__HOME__/logs/insurance-filer.err.log</string>
</dict></plist>
