// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderer: Elizabeth letter in the Bestly kit > matches the committed snapshot 1`] = `
"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark">
<title>Two new things on your board</title>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400&amp;display=swap" rel="stylesheet">
<style>
@media (prefers-color-scheme: dark) {
  .bg { background:#0b0d14 !important; } .card { background:#141414 !important; border-color:#242424 !important; }
  .bt { color:#fafafa !important; } .bh { color:#fafafa !important; } .bm { color:#a8a8a8 !important; } .bb { border-color:#242424 !important; } .eb { color:#7b8fe5 !important; } .bx { background:#1d1d1d !important; } .lk { color:#9aaaf0 !important; }
}
@media (max-width:520px) { .pad { padding:28px 22px !important; } .h1 { font-size:28px !important; line-height:32px !important; } }
</style></head>
<body style="margin:0;padding:0" class="bg">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all">Our call is now on your board, and you can send us videos to comment on.</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg" style="background:#faf9f7">
<tr><td align="center" style="padding:32px 12px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px">

  <tr><td style="border-radius:20px 20px 0 0;background:#0a0a0a;line-height:0;font-size:0"><a href="https://bestly.tech" target="_blank" title="bestly.tech" style="display:block;text-decoration:none;line-height:0"><img src="https://www.bestly.tech/email-templates/assets/bestly-header.gif" width="560" alt="Bestly" style="display:block;width:100%;max-width:560px;height:auto;border:0;border-radius:20px 20px 0 0;background:#0a0a0a;color:#fafafa;font:600 15px/20px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif"></a></td></tr>
  <tr><td class="card pad" style="background:#ffffff;border:1px solid #e7e5e0;border-top:0;border-radius:0 0 20px 20px;padding:36px 36px 32px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif">
    <p class="eb" style="margin:0 0 10px;font:600 12px/16px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#3b4a9c">A note from Jared</p>
    <h1 class="bh h1" style="margin:0 0 20px;font:400 32px/36px 'Newsreader',Georgia,'Times New Roman',serif;letter-spacing:-.02em;color:#111827">Two new things on your board.</h1>
    <p class="bt" style="margin:0 0 14px;font:400 16px/25px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">Hi Elizabeth,</p>
    <p class="bt" style="margin:0 0 14px;font:400 16px/25px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">A quick update before our call tomorrow. There are two new things on your board.</p>
    <p class="bh" style="margin:22px 0 6px;font:600 17px/24px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">1. Our call is now right on your board</p>
    <p class="bt" style="margin:0 0 14px;font:400 16px/25px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">Open your board and tap <b style="font-weight:600">Join</b>. The call opens in a small window, so you can still see your posts while we talk. If it asks to use your camera and microphone, tap <b style="font-weight:600">Allow</b>.</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 18px"><tr><td style="background:#3b4a9c;border-radius:12px"><a href="https://studio.bestly.tech/centering-you?c=EXAMPLE" target="_blank" style="display:inline-block;padding:14px 26px;font:600 16px/20px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#ffffff;text-decoration:none;border-radius:12px">Open my board</a></td></tr></table>
    <p class="bt" style="margin:0 0 14px;font:400 16px/25px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">If the call doesn't open for any reason, no stress. Use our usual link, the same one as always:</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 18px"><tr><td class="lk" style="border:1.5px solid #3b4a9c;border-radius:12px"><a href="https://cloud.bestly.tech/call/fyqvdsa4" target="_blank" class="lk" style="display:inline-block;padding:12.5px 24px;font:600 16px/20px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#3b4a9c;text-decoration:none;border-radius:12px">Join our usual call</a></td></tr></table>
    <p class="bh" style="margin:22px 0 6px;font:600 17px/24px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">2. Send us a video to comment on</p>
    <p class="bt" style="margin:0 0 14px;font:400 16px/25px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">See a video you'd like to comment on? On your board, tap <b style="font-weight:600">Comment on a video</b>, paste the link and tell us what you want to say. We'll polish your words and send them back. Then one tap copies your comment and opens the video. Just paste and post.</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 18px"><tr><td style="background:#3b4a9c;border-radius:12px"><a href="https://studio.bestly.tech/centering-you?c=EXAMPLE" target="_blank" style="display:inline-block;padding:14px 26px;font:600 16px/20px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#ffffff;text-decoration:none;border-radius:12px">Try it on my board</a></td></tr></table>
    <p class="bt" style="margin:0 0 28px;font:400 16px/25px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">See you tomorrow,</p>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="vertical-align:top;padding:0;width:56px"><img src="https://www.bestly.tech/email-templates/assets/jared-headshot.gif" width="56" height="56" alt="Jared Best" style="display:block;width:56px;height:56px;border:0;border-radius:28px"></td><td style="width:16px;min-width:16px;font-size:0;line-height:0">&nbsp;</td><td class="bb" style="vertical-align:top;padding:0 0 0 14px;border-left:2px solid #7a8be0"><div class="bh" style="font:600 15px/20px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827">Jared Best</div><div class="bm" style="padding-top:2px;font:400 13px/18px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#667085">Founder, <span class="bt" style="font:400 15px/18px 'Newsreader',Georgia,'Times New Roman',serif;color:#111827">Bestly</span></div><div style="padding-top:8px;font:400 13px/20px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif"><a class="lk" href="mailto:jared@bestly.tech" style="color:#3b4a9c;text-decoration:none">jared@bestly.tech</a><span class="bm" style="color:#667085">&nbsp;&nbsp;·&nbsp;&nbsp;</span><a class="lk" href="tel:+18165007236" style="color:#3b4a9c;text-decoration:none;white-space:nowrap">(816)&nbsp;500&#8209;7236</a></div></td></tr></table>
  </td></tr>
  
  <tr><td style="padding:26px 8px 0;text-align:center" align="center"><div style="height:2px;max-width:220px;margin:0 auto 14px;border-radius:2px;background:linear-gradient(90deg,rgba(228,3,3,0),#e40303 14%,#ff8c00 30%,#ffed00 46%,#008026 62%,#24408e 78%,rgba(115,41,130,0))"></div><p class="bm" style="margin:0 0 0;font:400 12px/18px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#667085">Bestly LLC · Gay-owned · Built in Los Angeles</p><p class="bm" style="margin:4px 0 0;font:400 12px/18px -apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#667085">Bestly builds AI agents and privacy-first apps for small businesses. <a class="lk" href="https://bestly.tech" style="color:#3b4a9c;text-decoration:none;font-weight:600;white-space:nowrap">See what we make</a></p></td></tr>

</table></td></tr></table></body></html>"
`;
