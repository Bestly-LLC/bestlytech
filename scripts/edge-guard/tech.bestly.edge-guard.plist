<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>tech.bestly.edge-guard</string>
  <!-- Edge Guard: Cloudflare + uptime guard. Once a minute. See docs/edge-guard.md -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jaredbest/bestly-agents/edge-guard/edge-guard.py</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/jaredbest/bestly-agents/edge-guard/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/jaredbest/bestly-agents/edge-guard/launchd.log</string>
</dict>
</plist>
