[Unit]
Description=Bestly Pi: answer unicast mDNS queries (Apple unicast assist) so Bestly Wall stays in iPhone AirPlay lists
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/bestly/airplay/mdns_unicast.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
